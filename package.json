{
  "name": "sso-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express 5 OpenID Connect provider service",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint eslint.config.js drizzle.config.ts src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "oidc-provider": "^9.12.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.54.0"
  }
}
