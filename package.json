{
  "name": "sso-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express 5 OpenID Connect provider service",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint eslint.config.js drizzle.config.ts vitest.config.ts src scripts test",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "e2e": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run test/e2e",
    "db:init": "node --import tsx --env-file-if-exists=.env scripts/init-db.ts",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --import tsx --env-file-if-exists=.env scripts/seed.ts",
    "user": "node --import tsx --env-file-if-exists=.env scripts/user.ts",
    "db:cleanup": "node --import tsx --env-file-if-exists=.env scripts/cleanup.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "oidc-provider": "^9.12.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.0.0",
    "jose": "^6.2.12",
    "supertest": "^7.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^5.0.4"
  }
}
