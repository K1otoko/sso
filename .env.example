# 认证中心 = 基础设施平面、独立入口（不经业务网关）。
# 生产部署：HOST=0.0.0.0（或容器网卡），OIDC_ISSUER=自有公网域名；
# 前置自有 LB/WAF 时保留 TRUST_PROXY=1，并限制服务端口只允许 LB 访问。
# Cookie 的 Secure 属性跟随 OIDC_ISSUER 的协议：HTTPS 自动启用，纯 HTTP 自动关闭。
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
OIDC_ISSUER=http://127.0.0.1:4000/oidc
OIDC_COOKIE_KEYS=replace-with-a-long-random-value,replace-with-another-long-random-value
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sso
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sso_test
LOGIN_UI_URL=http://127.0.0.1:5173/login
CORS_ORIGINS=http://127.0.0.1:5173
WEB_CLIENT_REDIRECT_URIS=http://127.0.0.1:5173/callback
JWKS_PATH=./secrets/jwks.json
API_RESOURCE=urn:sso:api
TRUST_PROXY=1
